# Copy to .env.backend in the repository root on the Windows VPS.
# Fill from existing private configuration; never commit .env.backend.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:55432/PRODUCT_DATABASE
BSC_INDEX_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:55432/INDEX_DATABASE
BSC_RPC_URL=https://YOUR-BNB-RPC-ENDPOINT.example
# Frontend origin for wallet SIWE identity. Must exactly match the production frontend URL.
PRODUCT_ORIGIN=https://YOUR-DOMAIN.example
# Optional FIRST-START settings. Omit on a new database to start at the current
# finalized BNB block (forward indexing only; earlier launches are not backfilled).
# BSC_START_BLOCK=YOUR_EARLIEST_REQUIRED_BLOCK
# BSC_LIVE_START_BLOCK=YOUR_LIVE_START_BLOCK
# BSC_INDEX_EPOCH=flap_v1
# After initialization, database settings take precedence on every restart.
# Older hash-only cursors must be adopted with their ORIGINAL settings first;
# do not remove/replace existing values until that adoption succeeds.
# Use stable secrets; ADMIN_TOKEN also protects admin routes if reachable through another transport.
IP_SALT=REPLACE_WITH_EXISTING_SECRET
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional persistent upload path; defaults to .local-media in the repository root.
# PRODUCT_MEDIA_DIR=C:/clashr-data/media
# PRODUCT_MARKET_ORIGIN is obsolete for the Node product runner: sync reads the index directly.
# Do not copy the old HTTP preview settings into this HTTPS backend configuration.
