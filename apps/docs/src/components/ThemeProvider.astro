{/* Clashr override: light paper is the default, like the landing page. Dark (the terminal palette) stays one click away. Inlined to avoid a flash. */}
<script is:inline>
	(() => {
		const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
		document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light';
	})();
</script>
