{
  "name": "@rushr/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:preview": "next dev --turbopack",
    "predev:preview": "node scripts/gen-whitepaper.mjs",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:hydration": "node scripts/check-landing-hydration.mjs",
    "test:dependencies": "vitest run test/wallet-dependencies.test.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "predev": "node scripts/gen-whitepaper.mjs",
    "prebuild": "node scripts/gen-whitepaper.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@privy-io/react-auth": "3.51.0",
    "@rushr/agents": "workspace:*",
    "@rushr/core": "workspace:*",
    "@rushr/trade": "workspace:*",
    "@solana-program/memo": "0.10.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@solana/sysvars": "5.5.1",
    "d3-force": "^3.0.1",
    "lightweight-charts": "^5.2.1",
    "motion": "^14.11.1",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.159.0"
  }
}
