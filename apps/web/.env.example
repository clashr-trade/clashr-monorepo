# Indexer API base URL (local: http://localhost:8788)
NEXT_PUBLIC_API_URL=http://localhost:8788
# Independent BSC read API origin, after the BSC ingester is ready. No Robinhood fallback.
# BSC_INDEXER_URL=http://localhost:8788
# Optional server-only BNB RPC provider. Defaults to the official BSC public endpoint for reads.
# BSC_RPC_URL=https://your-owned-bsc-provider.example
# Signing is opt-in, independent of the Robinhood swap flag. Leave off until spot rehearsal passes.
# NEXT_PUBLIC_BSC_SWAP_ENABLED=0
# Production only: the terminal's host (https://app.rushr.trade). Unset locally so app links stay relative.
# NEXT_PUBLIC_APP_URL=
# CLASHR BNB product. Keep APP_URL blank locally so navigation remains on localhost.
# NEXT_PUBLIC_PRODUCT_CHAIN_ID=56
# NEXT_PUBLIC_SITE_URL=https://clashr.trade
# PRODUCT_API_URL=http://127.0.0.1:8790

# Publish only the verified BNB CLASHR token contract after launch; blank keeps CA coming soon.
NEXT_PUBLIC_CLASHR_TOKEN_ADDRESS=

# Replace inherited community handles when CLASHR accounts are available.
NEXT_PUBLIC_X_URL=https://x.com/clashrtrade
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/clashrtrade

# Windows VPS HTTP preview: run `pnpm run env:vps` after configuring private values.
# This updates the following origins in .env.local (and .env.vps if present).
# DEV_ALLOWED_ORIGIN=http://135.181.237.187:3000
# NEXT_PUBLIC_APP_URL=http://135.181.237.187:3000
# NEXT_PUBLIC_SITE_URL=http://135.181.237.187:3000
# PRODUCT_ORIGIN=http://135.181.237.187:3000
# Explicit IP-only HTTP preview, including optimized Node builds. Unset for normal HTTPS hosting.
# CLASHR_HTTP_PREVIEW_ORIGIN=http://135.181.237.187:3000
# Internal metadata sync bypasses the public origin's TLS redirects/firewall.
# PRODUCT_MARKET_ORIGIN=http://127.0.0.1:3000
# DEV_ALLOWED_ORIGIN remains development-only. HTTP preview is unencrypted.
