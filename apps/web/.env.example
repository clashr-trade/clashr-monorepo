# Indexer API base URL (local: http://localhost:8788)
NEXT_PUBLIC_API_URL=http://localhost:8788
# Independent BSC read API origin, after the BSC ingester is ready. No Robinhood fallback.
# BSC_INDEXER_URL=http://localhost:8788
# Optional server-only BNB RPC provider. Defaults to the official BSC public endpoint for reads.
# BSC_RPC_URL=https://your-owned-bsc-provider.example
# Signing is opt-in, independent of the Robinhood swap flag. Leave off until spot rehearsal passes.
# NEXT_PUBLIC_BSC_SWAP_ENABLED=0
# Production only: the terminal's host (https://app.rushr.trade). Unset locally so app links stay relative.
# NEXT_PUBLIC_APP_URL=
