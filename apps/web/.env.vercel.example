# Configure these in Vercel, not in the VPS environment.
CLASHR_WEB_RUNTIME=node
NEXT_PUBLIC_PRODUCT_CHAIN_ID=56
PRODUCT_API_URL=https://api.YOUR-DOMAIN.example
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example
# Blank keeps navigation on the current deployment (including preview URLs).
NEXT_PUBLIC_APP_URL=
# Private server-side RPC endpoint used by /api/rpc and market reads. Never NEXT_PUBLIC_.
BSC_RPC_URL=https://YOUR-BNB-RPC-ENDPOINT.example
NEXT_PUBLIC_BSC_SWAP_ENABLED=1
NEXT_PUBLIC_X_URL=https://x.com/clashrdottrade
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/clashrtrade
NEXT_PUBLIC_GITHUB_URL=https://github.com/clashr-trade
NEXT_PUBLIC_CLASHR_TOKEN_ADDRESS=
# Optional: copy your existing BNB Privy app ID if using that integration.
# NEXT_PUBLIC_BSC_PRIVY_APP_ID=
# Do not set DATABASE_URL, BSC_INDEX_DATABASE_URL, DEV_ALLOWED_ORIGIN or CLASHR_HTTP_PREVIEW_ORIGIN here.
