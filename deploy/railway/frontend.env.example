# Railway frontend variables. Keep repository Root Directory at /.
RAILPACK_NODE_VERSION=22.23.5
RAILPACK_NODE_INSTALL_PATTERNS=patches/**
RAILPACK_PRUNE_DEPS=false
CLASHR_WEB_RUNTIME=node
CLASHR_DEPLOYMENT=railway
NEXT_PUBLIC_PRODUCT_CHAIN_ID=56
PORT=3000
# Service must be named backend, with PORT=8790, in the same project/environment.
PRODUCT_API_URL=http://backend.railway.internal:8790
# Replace with the HTTPS URL generated by Railway for the frontend before deployment.
NEXT_PUBLIC_SITE_URL=https://YOUR-FRONTEND.up.railway.app
NEXT_PUBLIC_APP_URL=
BSC_RPC_URL=YOUR_PRIVATE_BNB_RPC_URL
NEXT_PUBLIC_BSC_SWAP_ENABLED=1
NEXT_PUBLIC_X_URL=https://x.com/clashrdottrade
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/clashrtrade
NEXT_PUBLIC_GITHUB_URL=https://github.com/clashr-trade
# Copy your existing public Privy app ID if using Privy; never put DB credentials here.
