RAILPACK_NODE_VERSION=22.23.5
RAILPACK_NODE_INSTALL_PATTERNS=patches/**
# tsx is a runtime requirement for the worker scripts; keep workspace dev dependencies.
RAILPACK_PRUNE_DEPS=false
CLASHR_DEPLOYMENT=railway
PORT=8790
PRODUCT_API_HOST=::
# Railway reference variables: add in the service Variables editor.
DATABASE_URL=${{Postgres.DATABASE_URL}}
BSC_INDEX_DATABASE_URL=${{Postgres.DATABASE_URL}}
BSC_RPC_URL=YOUR_PRIVATE_BNB_RPC_URL
PRODUCT_ORIGIN=https://YOUR-FRONTEND.up.railway.app
IP_SALT=GENERATE_A_STABLE_RANDOM_SECRET
ADMIN_TOKEN=GENERATE_A_SEPARATE_STABLE_RANDOM_SECRET
# Attach a Railway volume to the BACKEND at /data; required for durable profile media.
PRODUCT_MEDIA_DIR=/data/media
# New index starts at current finalized block by default. For historical coverage,
# specify the earliest needed block BEFORE the first backend startup.
# BSC_START_BLOCK=YOUR_EARLIEST_REQUIRED_BLOCK
# BSC_LIVE_START_BLOCK=YOUR_LIVE_START_BLOCK
# No VPS credentials, cursor state or user data is imported by this configuration.
