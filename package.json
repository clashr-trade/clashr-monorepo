{
  "name": "clashr-core",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "env:vps": "node scripts/configure-vps-env.mjs",
    "start:vps": "node scripts/web-node.mjs start --hostname 0.0.0.0",
    "check:backend": "node scripts/dev-backend.mjs --check-rpc",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:web": "pnpm --filter @clashr/web dev",
    "build:web": "node scripts/web-node.mjs build",
    "start:web": "node scripts/web-node.mjs start",
    "dev:indexer": "pnpm --filter @clashr/indexer dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "publish:oss": "bash scripts/publish-oss.sh"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
